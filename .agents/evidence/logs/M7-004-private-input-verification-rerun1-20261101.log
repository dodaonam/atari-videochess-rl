out={}
for name,(raw,expected) in roots.items():
 root=Path(raw); manifest=root/'artifact-manifest.json'; digest=hashlib.sha256(manifest.read_bytes()).hexdigest()
 doc=verify_artifact_manifest(root)
 if digest!=expected: raise SystemExit(f'{name} manifest hash mismatch')
 out[name]={'manifest_sha256':digest,'file_count':len(doc['files']),'total_bytes':doc['total_bytes'],'status':'verified'}
print(json.dumps(out,sort_keys=True))

